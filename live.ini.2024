###
# app configuration
# http://docs.pylonsproject.org/projects/pyramid/en/latest/narr/environment.html
###

[app:main]
use = egg:opensipkd-rpc
reload_templates = true
debug_authorization = false
debug_notfound = false
debug_routematch = false
debug_templates = true
default_locale_name = en
sqlalchemy.url = postgresql://sugiana:a@172.16.8.11/rpc2
#pbb.url = oracle://pbb:Z2184SDNHGF8121RT58@192.168.1.250/simpbb
pbb.url = oracle://pbb:PLMZAQ0192OKNXSW@172.16.8.3/simpbb
#pbb.url = postgresql://pbb:p88p21975@localhost:5432/pbb
pbb_schema = pbb
pyramid.includes =
    pyramid_debugtoolbar
    pyramid_tm
    
session.type = ext:database
session.secret = s0s3cr3t
session.cookie_expires = true
session.key = WhatEver
session.url = postgresql://sugiana:a@172.16.8.11/rpc2
session.timeout = 3000
session.lock_dir = %(here)s/tmp

timezone = Asia/Jakarta
localization = id_ID.UTF-8

static_files = %(here)s/../files

[server:main]
use = egg:waitress#main
host = 0.0.0.0
port = 6543

# Begin logging configuration

[loggers]
keys = root, opensipkdrpc, sqlalchemy

[handlers]
keys = console

[formatters]
keys = generic

[logger_root]
level = INFO
handlers = console

[logger_opensipkdrpc]
level = DEBUG
handlers =
qualname = opensipkdrpc

[logger_sqlalchemy]
level = INFO
handlers =
qualname = sqlalchemy.engine
# "level = INFO" logs SQL queries.
# "level = DEBUG" logs SQL queries and results.
# "level = WARN" logs neither.  (Recommended for production systems.)

[handler_console]
class = StreamHandler
args = (sys.stderr,)
level = NOTSET
formatter = generic

[formatter_generic]
format = %(asctime)s %(levelname)-5.5s [%(name)s][%(threadName)s] %(message)s

# End logging configuration
